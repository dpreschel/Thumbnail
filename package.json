{
  "name": "site-thumbnailer",
  "version": "0.1.0",
  "private": true,
  "description": "POC: capture a website's title, description, canonical URL and a screenshot thumbnail.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
